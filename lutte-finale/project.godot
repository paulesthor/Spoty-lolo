config_version=5

[application]
config/name="Communiste Land"
config/description="Survivor-like 3D satirique (prototype)"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"

[autoload]

Meta="*res://scripts/meta.gd"
Snd="*res://scripts/snd.gd"
Net="*res://scripts/net.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]
common/physics_ticks_per_second=60

[rendering]

mesh_lod/lod_change/threshold_pixels=8.0
renderer/rendering_method="gl_compatibility"
occlusion_culling/use_occlusion_culling=true
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
